# ---------- ZoomInfo (Developer Portal > create a Standard App > Client Credentials) ----------
ZOOMINFO_CLIENT_ID=
ZOOMINFO_CLIENT_SECRET=
ZOOMINFO_BASE_URL=https://api.zoominfo.com/gtm
ZOOMINFO_TOKEN_URL=https://api.zoominfo.com/gtm/oauth/v1/token
# Optional space-separated subset of the scopes enabled on your app. Blank = all app scopes.
ZOOMINFO_SCOPE=
# Use the app Client Secret, NOT a temporary Test API Access token.
# The backend reads expires_in and renews access tokens automatically on API use.
# Check the exact value with: python main.py --lookup countries
DEFAULT_COUNTRY=United Kingdom

# ---------- LLM: gemini | anthropic | none (none = rule-based fallback) ----------
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---------- Email signature ----------
SENDER_NAME=Muhammad
SENDER_TITLE=Employer Partnerships
SENDER_EMAIL=support@wtd.org.uk
SENDER_PHONE=020 3411 0180

# ---------- Optional Microsoft 365 email (single-tenant Entra Web app; no dashboard login) ----------
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/auth/microsoft/callback
# Generated by setup_local.py. Keep stable and back it up separately from the database.
TOKEN_ENCRYPTION_KEY=
DAILY_SEND_LIMIT=30

# ---------- FastAPI web backend ----------
# python setup_local.py generates API_KEY and frontend/.env.local for you.
API_KEY=
# Leave blank to use data/app.sqlite3 under the project directory.
DATABASE_PATH=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------- Optional: LangSmith tracing (see every graph run step by step) ----------
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=wtd-lead-gen
